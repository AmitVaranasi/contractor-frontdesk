# Copy to .env.local. Every integration is optional except where noted; the app labels fallbacks in the UI.

# --- Phone line (Vapi) — required for real calls ---
VAPI_API_KEY=                 # dashboard.vapi.ai → API Keys (private key)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=  # same page (public key) — browser test calls
VAPI_SERVER_SECRET=           # any long random string: openssl rand -hex 24
PUBLIC_BASE_URL=              # https URL that reaches this app, e.g. from `npm run tunnel`
VAPI_PHONE_NUMBER=            # printed by `npm run phone:setup`, shown in the portal
VAPI_PHONE_NUMBER_ID=
VAPI_MODEL_PROVIDER=anthropic # Vapi-hosted Claude, billed to Vapi credits (no Anthropic key needed)
VAPI_MODEL=claude-sonnet-5
# VAPI_VOICE_PROVIDER=
# VAPI_VOICE_ID=

# --- Agent faces and voices (Masky) ---
MASKY_API_KEY=                # https://masky.ai/developer — then run `npm run masky:setup`
MASKY_AVATAR_MAYA=
MASKY_AVATAR_LEO=
MASKY_AVATAR_NIA=
MASKY_AVATAR_ARUN=
MASKY_AVATAR_SAM=

# --- Executive agents' reasoning (RocketRide pipeline → Flatkey → rules) ---
ROCKETRIDE_APIKEY=
ROCKETRIDE_URI=https://api.rocketride.ai
FLATKEY_API_KEY=
FLATKEY_BASE_URL=https://router.flatkey.ai/v1
FLATKEY_MODEL=                # Claude model name as Flatkey lists it
ROCKETRIDE_FLATKEY_MODEL=claude-sonnet-4-6   # RocketRide node sends temperature; Opus 5.5 rejects it
# ANTHROPIC_API_KEY=          # optional direct path
LLM_PROVIDER_ORDER=rocketride,anthropic,flatkey

# --- CTO sandbox (Celesto) ---
CELESTO_API_KEY=
CELESTO_REPO_URL=             # https://github.com/<you>/<repo> — test suite runs in a clean sandbox

# --- Follow-up automation (n8n) ---
N8N_WEBHOOK_URL=              # Webhook URL of the imported n8n/followup-workflow.json
N8N_WEBHOOK_SECRET=
